# Copia este fichero a .env (está en .gitignore, no se sube al repositorio) y rellena los valores.
# Lo leen la aplicación al arrancar en local y docker compose.

# Contraseña del usuario postgres de la base de datos fleet_db
DB_PASSWORD=

# Clave para firmar los JWT: Base64 de al menos 32 bytes aleatorios. Se genera con: openssl rand -base64 48
JWT_SECRET=

# Administrador inicial: solo se crea si no existe ningún administrador. Tras el primer arranque pueden quitarse
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Super administrador: un administrador que además puede desactivar y reactivar cuentas (conductores, encargados y
# administradores) conservando su historial. Se crea si no existe ninguno; si el usuario ya es administrador, se le da el
# rango sin tocar su contraseña. Tras el primer arranque pueden quitarse
SUPER_ADMIN_USERNAME=
SUPER_ADMIN_PASSWORD=

# Límite de intentos de login: tras varios fallos seguidos se bloquea el inicio de sesión 15 minutos (429).
# Sin definir: activado. Ponlo a false solo para depurar
# LOGIN_RATE_LIMIT_ENABLED=true

# Días que se conservan los mensajes del chat de las olas y sus fotos; los más antiguos se borran cada noche.
# 0 = no borrar nunca. Sin definir: 30
# CHAT_RETENTION_DAYS=30

# Dominio público de la API cuando se publica con HTTPS (docker compose --profile https up -d), por ejemplo
# api.miempresa.com. Tiene que apuntar al servidor, con los puertos 80 y 443 abiertos. En local no hace falta
# NOPAR_DOMAIN=

# Orígenes desde los que la web puede llamar a la API, separados por comas (admite patrones como http://localhost:*).
# Vacío = ninguno. Android e iOS no lo necesitan
CORS_ALLOWED_ORIGINS=

# Swagger UI y contrato OpenAPI (/swagger-ui.html, /v3/api-docs). En producción: false
OPENAPI_ENABLED=true

# Imprime en el log el SQL que ejecuta Hibernate. Útil para depurar; en producción, false.
# Sin definir: activado al arrancar en local y desactivado en docker compose
# SHOW_SQL=true

# Cuántos minutos, desde que se llama a una ola, pueden los conductores pulsar «Enterado». Pasados, la orden caduca.
# Sin definir: 60
# WAVE_CALL_ACK_WINDOW_MINUTES=2

# Notificaciones push de los avisos (Firebase Cloud Messaging). Desactivadas por defecto: la API funciona igual pero
# no envía nada. Para activarlas, en la consola de Firebase (Configuración del proyecto > Cuentas de servicio) genera
# una clave privada y guarda el JSON FUERA del repositorio:
#  - en local: FCM_ENABLED=true y FCM_CREDENTIALS_FILE con la ruta del JSON.
#  - con docker compose: FCM_ENABLED=true y el JSON en ./secrets/firebase-service-account.json (carpeta ignorada por
#    git y por Docker; el fichero tiene que poder leerlo cualquier usuario, p. ej. chmod 644).
#  - sin ficheros secretos (Railway): FCM_ENABLED=true y FCM_CREDENTIALS_JSON con el JSON en Base64 (una sola línea).
#    En PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("secrets\firebase-service-account.json"))
# Si están las dos, manda el fichero. Si está activado y las credenciales no se pueden leer, la aplicación no arranca.
# FCM_ENABLED=true
# FCM_CREDENTIALS_FILE=
# FCM_CREDENTIALS_JSON=

# Copias de seguridad automáticas (docker compose --profile backup up -d): se guardan en ./backups cada
# BACKUP_EVERY_HOURS horas (sin definir: 24) y se conservan BACKUP_KEEP_DAYS días (sin definir: 14)
# BACKUP_EVERY_HOURS=24
# BACKUP_KEEP_DAYS=14
