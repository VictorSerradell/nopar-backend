# Copia este fichero a .env (está en .gitignore, no se sube al repositorio) y rellena los valores.
# Lo leen la aplicación al arrancar en local y docker compose.

# Contraseña del usuario postgres de la base de datos fleet_db
DB_PASSWORD=

# Clave para firmar los JWT: Base64 de al menos 32 bytes aleatorios. Se genera con: openssl rand -base64 48
JWT_SECRET=

# Administrador inicial: solo se crea si no existe ningún administrador. Tras el primer arranque pueden quitarse
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Orígenes desde los que la web puede llamar a la API, separados por comas (admite patrones como http://localhost:*).
# Vacío = ninguno. Android e iOS no lo necesitan
CORS_ALLOWED_ORIGINS=

# Swagger UI y contrato OpenAPI (/swagger-ui.html, /v3/api-docs). En producción: false
OPENAPI_ENABLED=true

# Imprime en el log el SQL que ejecuta Hibernate. Útil para depurar; en producción, false.
# Sin definir: activado al arrancar en local y desactivado en docker compose
# SHOW_SQL=true
